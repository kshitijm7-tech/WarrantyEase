# WarrantyEase API - Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Application
APP_ENV=development
APP_NAME=WarrantyEase API
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8001

# AWS
# For local development with named profile (e.g., "warrantyease-local")
# AWS_PROFILE=warrantyease-local
# AWS_REGION=ap-south-1
# For local DynamoDB (uses local credentials)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# DynamoDB Local
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_TABLE_NAME=WarrantyEase-Dev

# S3 (for invoice uploads - uses AWS_PROFILE credentials)
S3_BUCKET_NAME=warrantyease-invoices-vu1

# CORS - Frontend origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001